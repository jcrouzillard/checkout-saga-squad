# Ambiente de teste compartilhado (D15, ADR-018, docs/contracts/ambiente-de-teste.md §2.2).
# Uso exclusivo: docker compose -p checkout-teste --env-file infra/teste/teste.env <comando>
# (quem executa é tools/squad/testenv.py, dentro do worktree plankton-teste/).
# Passado com --env-file: o .env da cópia principal nunca é lido pelo teste e este
# arquivo nunca é lido pelo produtivo. Sem segredos.
# Regra forte: porta do teste = porta do produtivo + 10000 (nenhuma colide com o
# produtivo, com a 3000 de outro projeto local nem com a 7070 do Squad Control).

COMPOSE_PROJECT_NAME=checkout-teste
IMAGE_NAMESPACE=checkout-teste

# Serviços de aplicação (produtivo 8080-8084)
SAGA_PORT=18080
ORDER_PORT=18081
INVENTORY_PORT=18082
PAYMENT_PORT=18083
SHIPPING_PORT=18084

# Console do produto (produtivo 8090)
CONSOLE_PORT=18090

# Infraestrutura (produtivo 5432, 29092)
POSTGRES_PORT=15432
KAFKA_EXTERNAL_PORT=39092

# Observabilidade (produtivo 16686, 4317/4318, 9090, 3001 pelo .env)
JAEGER_UI_PORT=26686
OTLP_GRPC_PORT=14317
OTLP_HTTP_PORT=14318
PROMETHEUS_PORT=19090
GRAFANA_PORT=13001
