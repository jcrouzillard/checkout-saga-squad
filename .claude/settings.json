{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/tools/squad/executores.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" guard-agent",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
