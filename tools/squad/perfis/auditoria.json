{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": ["Read", "Glob", "Grep", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
              "Bash(git status:*)", "Bash(ls:*)"],
    "deny": ["Bash(git diff --output:*)", "Bash(git diff --no-index:*)", "Bash(git diff --ext-diff:*)",
             "Bash(git log --output:*)", "Bash(git show --output:*)",
             "Write", "Edit", "NotebookEdit", "WebFetch", "WebSearch", "Task", "Agent",
             "Read(~/.ssh/**)", "Read(~/.aws/**)", "Read(~/.config/**)", "Read(~/.claude/**)", "Read(~/.codex/**)",
             "Read(~/.gnupg/**)", "Read(~/.docker/**)", "Read(~/.kube/**)", "Read(~/.azure/**)", "Read(~/Library/Keychains/**)",
             "Read(~/.netrc)", "Read(~/.gitconfig)", "Read(~/.git-credentials)", "Read(~/.npmrc)",
             "Read(~/.pypirc)", "Read(~/.pgpass)"]
  }
}
