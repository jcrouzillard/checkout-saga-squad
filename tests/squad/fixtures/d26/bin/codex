#!/usr/bin/env python3
"""`codex` FALSO (D26, QA) — custo zero. Nunca chama um modelo.
- `--version` → versão; `login status` → 0 só se $CODEX_HOME/auth.json existir (CODEX_HOME vazio = "sem login").
- `exec ...` → registra argv em $FAKE_CALLS; FAKE_CODEX_MODE=ok (padrão) imprime o cabeçalho do Codex
  (model: $FAKE_CODEX_MODEL / provider: openai) e sai 0; authfail = "401 Unauthorized" e sai 1.
"""
import json, os, sys
a = sys.argv[1:]
if a[:1] == ["--version"]:
    print("codex-cli 0.156.1"); sys.exit(0)
if a[:2] == ["login", "status"]:
    home = os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex")
    if os.path.exists(os.path.join(home, "auth.json")):
        print("Logged in using ChatGPT"); sys.exit(0)
    print("Not logged in", file=sys.stderr); sys.exit(1)
calls = os.environ.get("FAKE_CALLS")
if calls:
    with open(calls, "a") as f:
        f.write(json.dumps({"bin": "codex", "argv": a, "cwd": os.getcwd(),
                            "SQUAD_MODEL": os.environ.get("SQUAD_MODEL"), "SQUAD_RUN": os.environ.get("SQUAD_RUN")}) + "\n")
if os.environ.get("FAKE_CODEX_MODE", "ok") == "authfail":
    print("ERROR: 401 Unauthorized — run `codex login`"); sys.exit(1)
m = a[a.index("-m") + 1] if "-m" in a else os.environ.get("FAKE_CODEX_MODEL", "gpt-5.6-sol")
print("OpenAI Codex v0.156.1 (research preview)\n--------\nworkdir: .\nmodel: " + m + "\nprovider: openai\n"
      "approval: never\nsandbox: read-only\n--------\nuser\nprompt\n\ncodex\nOK (codex falso)")
