# Exemplo de variáveis de ambiente opcionais para uso local com `docker compose`.
# Os valores padrão já usados em docker-compose.yml (usuário/senha "checkout",
# portas 8080-8084, etc.) funcionam sem este arquivo — ele existe apenas para
# quem quiser sobrescrever algo pontualmente (copie para ".env").

# Credenciais do Postgres (iguais em todos os serviços; ver infra/postgres/init).
POSTGRES_USER=checkout
POSTGRES_PASSWORD=checkout

# Nível de log Spring (root) para depuração local.
LOGGING_LEVEL_ROOT=INFO
